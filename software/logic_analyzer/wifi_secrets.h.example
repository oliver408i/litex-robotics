/*
 * wifi_secrets.h — Wi-Fi credentials for the ATWINC1500 demos.
 *
 * TEMPLATE. The real header is gitignored (it holds your password). To build
 * software/winc_test or software/winc_loader:
 *
 *     cp wifi_secrets.h.example wifi_secrets.h
 *     # then edit wifi_secrets.h with your network's SSID and passphrase
 *
 * Both apps include this file directly; winc_loader resolves it from
 * ../winc_test via -I (see its Makefile), so only this one copy is needed.
 *
 * Only WPA2-PSK is wired up here (m2m_wifi_connect with M2M_WIFI_SEC_WPA_PSK).
 */
#ifndef WIFI_SECRETS_H_
#define WIFI_SECRETS_H_

/* Network name (SSID), as a C string. Max 32 chars per 802.11. */
#define WIFI_SSID "your-network-name"

/* WPA2 passphrase, as a C string. 8–63 chars. */
#define WIFI_PSK  "your-wifi-password"

#endif /* WIFI_SECRETS_H_ */
