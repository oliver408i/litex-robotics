+ * through -> instant crash. The master is then left for SDRAM-resident apps. */
+#if defined(CSR_SPIFLASH_MASTER_CS_ADDR) && !defined(SPIFLASH_SKIP_MASTER_INIT)
 
 	spiflash_read_id_register();
 
