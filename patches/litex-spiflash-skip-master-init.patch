--- a/litex/soc/software/liblitespi/spiflash.c
+++ b/litex/soc/software/liblitespi/spiflash.c
@@ -305,7 +305,11 @@ void spiflash_init(void)
 	spiflash_dummy_bits_setup(SPIFLASH_MODULE_DUMMY_BITS);
 #endif
 
-#ifdef CSR_SPIFLASH_MASTER_CS_ADDR
+/* SPIFLASH_SKIP_MASTER_INIT: skip all master commands (read-ID, quad enable) at
